# Database Configuration
# Default is local asynchronous SQLite for standalone development:
DATABASE_URL=sqlite+aiosqlite:///./fitness_db.sqlite
# For PostgreSQL container deployment:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/fitness_db

# Security & Authentication
JWT_SECRET_KEY=bodymaxxing-super-secure-production-secret-key-32b

# AI Agent Configuration
AI_MODEL=openai:gpt-4o
# OPENAI_API_KEY=your-openai-api-key-here

# CORS & Server Settings
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8550,http://127.0.0.1:8550
